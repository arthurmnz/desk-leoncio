# ==============================================================================
# DeskBot - Firmware ESP32 + Tela TFT ILI9341
# ==============================================================================
# Configurações de ambiente do microcontrolador ESP32.
# Nota: No firmware Arduino/ESP32 (deskbot.ino), essas configurações são lidas a
# partir de 'secrets.h' (copie de 'secrets.h.example'). Este .env.example serve como
# especificação das variáveis de ambiente de rede e broker para PlatformIO, scripts
# de provisionamento, flashing automatizado ou CI.

# Nome da rede Wi-Fi (ATENÇÃO: o ESP32 suporta apenas redes 2.4 GHz)
WIFI_SSID=sua_rede_wifi_2.4ghz

# Senha da rede Wi-Fi
WIFI_PASS=sua_senha_wifi_aqui

# Endereço IP ou hostname do broker MQTT no homelab
MQTT_HOST=192.168.0.50

# Porta do broker MQTT (Padrão: 1883)
MQTT_PORT=1883

# Tópico MQTT que o ESP32 assina para receber os estados e expressões do robô
MQTT_TOPIC=desk/bot/state
