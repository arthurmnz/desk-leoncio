# ==============================================================================
# DeskBot - Servidor Homelab (Docker / cerebro.py / Mosquitto)
# ==============================================================================

# Fuso horário do container do cérebro no Docker Compose (ex: America/Fortaleza, America/Sao_Paulo, UTC)
TZ=America/Fortaleza

# Endereço/host do broker MQTT.
# - No Docker Compose: mosquitto (nome do serviço na rede interna Docker)
# - Executando cerebro.py diretamente no host: localhost ou IP da máquina
BROKER=mosquitto

# Caminho para gravação do arquivo de log de humor e atividades (CSV).
# - No Docker Compose: /app/dados/deskbot_log.csv (montado no volume ./dados)
# - Executando localmente: dados/deskbot_log.csv
LOG=/app/dados/deskbot_log.csv
