# ==============================================================================
# DeskBot - Variáveis de Ambiente Globais (Monorepo)
# ==============================================================================
# O DeskBot é composto por 3 módulos independentes, cada um com seu próprio
# arquivo .env.example específico em seu diretório:
#
# 1. deskbot-server/ : Mosquitto MQTT broker e cérebro no Homelab (Docker)
# 2. deskbot-pc/     : Agente de monitoramento de janelas e processos nos PCs
# 3. deskbot/        : Firmware para microcontrolador ESP32 + Display ILI9341
#
# Copie este modelo ou utilize os arquivos específicos de cada pasta conforme o caso.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. deskbot-server (Homelab / Docker / cerebro.py)
# ------------------------------------------------------------------------------
# Fuso horário do container do cérebro
TZ=America/Fortaleza

# Host do broker MQTT (usar 'mosquitto' no Docker Compose, 'localhost' localmente)
BROKER=mosquitto

# Caminho do arquivo de log CSV
LOG=/app/dados/deskbot_log.csv


# ------------------------------------------------------------------------------
# 2. deskbot-pc (Agente no Linux ou Windows)
# ------------------------------------------------------------------------------
# IP ou hostname do homelab onde o broker MQTT está rodando (Obrigatório)
DESKBOT_BROKER=192.168.0.50

# Nome identificador do PC no MQTT (Opcional, padrão: "windows" ou "cachyos")
DESKBOT_NOME=windows


# ------------------------------------------------------------------------------
# 3. deskbot (ESP32 Firmware)
# ------------------------------------------------------------------------------
# No ESP32, essas variáveis correspondem às constantes do 'secrets.h'
WIFI_SSID=sua_rede_wifi_2.4ghz
WIFI_PASS=sua_senha_wifi_aqui
MQTT_HOST=192.168.0.50
MQTT_PORT=1883
MQTT_TOPIC=desk/bot/state
