# ==============================================================================
# DeskBot - Agente de Monitoramento do PC (Linux / Windows)
# ==============================================================================

# IP ou hostname do homelab onde o broker MQTT Mosquitto está rodando (Obrigatório).
# Exemplo: 192.168.0.50 ou homelab.local
DESKBOT_BROKER=192.168.0.50

# Nome identificador deste computador no tópico MQTT (desk/pc/<nome>/activity).
# Opcional: Se não definido, o agente usará "windows" no Windows ou "cachyos" no Linux.
# Exemplo: windows, cachyos, notebook, desktop-trabalho
DESKBOT_NOME=windows
